<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色下这几处同色,统一取页面底的渲染色 #111111。
         历史:#232325 是"站点顶栏"的实测渲染色(顶栏玻璃底 rgba(17,17,17,.72) 被算法加深抬高),
         当时为了让状态栏与顶栏连成一片而写它。但 2026-09-26 按需求"深色模式状态栏改成背景色":
         状态栏应当与页面底同色,而不是与那条更亮的顶栏同色。
         实测:状态栏(原 #232325)正下方就是页面底 #111111,顶栏本身也只是半透明玻璃,
         所以状态栏取 #111111 后视觉上直接并入页面,顶部不再有那条亮带。 -->
    <color name="app_background">#111111</color>
    <color name="web_surface">#111111</color>
</resources>
